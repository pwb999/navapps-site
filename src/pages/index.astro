---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="NavApps">
  <main class="max-w-5xl mx-auto px-6 py-16">
<header class="text-center mb-20">

  <div class="mb-8">

    <img

      src="/navapps-site/navappsLogo.png"

      alt="NavApps Logo"

      class="mx-auto w-72 sm:w-80 md:w-[420px] h-auto"

    />

  </div>

  <p class="text-lg text-slate-300 max-w-2xl mx-auto">

    Navigation and astronomy tools for Apple Watch.

    Designed for outdoor use, natural navigation, and learning the sky.

  </p>

</header>

    <section class="grid sm:grid-cols-2 gap-10 mb-20">
      <div>
        <h2 class="text-xl font-semibold mb-3">Apple Watch Apps</h2>
        <p class="text-slate-300">
          Apple Watch apps focused on clarity, accuracy, and real-world usefulness —
          from solar and lunar paths to night navigation and magnetic variation.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold mb-3">Built by an Independent Developer</h2>
        <p class="text-slate-300">
          NavApps is developed and maintained in Cumbria (UK), with a focus on straight forward, reliable, simple, offline use
          where possible.
        </p>
      </div>
    </section>

    <section class="text-center">
      <a href="navapps-site/apps" class="inline-block bg-yellow-400 text-slate-900 font-semibold px-6 py-3 rounded-xl hover:bg-yellow-300 transition">
        View Apps
      </a>
    </section>

    <footer class="mt-24 text-center text-sm text-slate-500">
      © 2026 NavApps · Support: support@navapps.org
    </footer>
  </main>
</BaseLayout>
