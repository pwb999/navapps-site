---
import BaseLayout from "../layouts/BaseLayout.astro";

const apps = [
  {
    name: "Arcus Solis -  Solar Path",
    status: "Live",
    tagline: "Simply the Sun azimuth, altitude with solar noon,rise/sun and set times — just the essentials",
    bullets: ["Sun path visualisation", "Azimuth + altitude", "Sunrise/sunset azimuths"],
    href: "https://apps.apple.com/no/app/arcus-solis/id6759111095",
    icon: "☀️",
  },
  {
    name: "Arcus Lunae - Moon Path",
    status: "Live",
    tagline: "Moonrise/set, phase, illumination, and the Moon’s track across the sky.",
    bullets: ["altitude and azimuth", "Phase + illumination", "Rise/set + timing"],
    href: "https://apps.apple.com/pl/app/arcus-lunae/id6747908818",
    icon: "🌙",
  },
  {
    name: "Night Nav",
    status: "Coming soon",
    tagline: "Learn key stars and use heading-based suggestions for night navigation.",
    bullets: ["Star shortlist by heading", "Alt/az guidance", "Simple learning flow"],
    href: "#",
    icon: "⭐️",
  },
  {
    name: "Magnetic Variation",
    status: "Live",
    tagline: "Displays World Magnetic Model declination to convert between true and magnetic bearings.",
    bullets: ["Offline-ready model", "Declination at location", "True ↔︎ magnetic guidance"],
    href: "https://apps.apple.com/no/app/truemag/id6747299823",
    icon: "🧭",
  },
  {
    name: "Solar Noon",
    status: "Live",
    tagline: "Calculates your Local Solar Noon time.",
    bullets: ["Max Altitude of Sun", "Longitude", "Find your Latitude"],
    href: "https://apps.apple.com/no/app/solar-noon/id6749851131",
    icon: "🗺️",
  },
  {
    name: "Sol et Luna - Sun & Moon",
    status: "Coming soon",
    tagline: "Combined sun + moon page for quick situational awareness outdoors.",
    bullets: ["Sun + Moon together", "Azimuth + altitude", "Next key events"],
    href: "#",
    icon: "🌗",
  },
  {
    name: "Sun Azimuths",
    status: "Live",
    tagline: "Create a Table of Sun Azimuths for Each Hour before and after Local Solar Noon.",
    bullets: ["Sun Azimuths", "Gatty", "Completely Offline"],
    href: "https://apps.apple.com/no/app/sun-azimuths/id6753765101",
    icon: "🪐",
  },
  {
    name: "Moon calendar",
    status: "Live",
    tagline: "All the phases of the Moon worldwide",
    bullets: ["Moon", "Global", "Phases"],
    href: "https://apps.apple.com/no/app/moon-calendar/id6753690599",
    icon: "⏱️",
  },
];

const live = apps.filter((a) => a.status === "Live");
const soon = apps.filter((a) => a.status !== "Live");
---

<BaseLayout title="Field Tools for Apple Watch">
<main class="max-w-6xl mx-auto px-6 pt-8 pb-14">
<header class="text-center mb-12 pt-4">

  <div class="mb-8">

    <img

      src="/navapps-site/navappsLogo.png"

      alt="NavApps Logo"

      class="mx-auto w-80 sm:w-96 md:w-[460px] h-auto"

    />

  </div>

  <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">

    Practical outdoor navigation tools designed specifically for Apple Watch.

    <br />

    Built for clarity, accuracy and ease of use in the field.

  </p>

</header>
    <section class="mb-14">
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <h2 class="text-xl font-semibold">Available now</h2>
        <a href="/" class="text-sm text-slate-400 hover:text-slate-200">Back to home</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {live.map((app) => (
          <article class="group rounded-2xl border border-slate-800 bg-slate-900/40 p-6 shadow-sm hover:border-slate-700 transition">
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="h-11 w-11 grid place-items-center rounded-xl bg-slate-800 text-xl">
                  {app.icon}
                </div>
                <div>
                  <h3 class="text-lg font-semibold">{app.name}</h3>
                  <p class="text-xs text-slate-400">{app.tagline}</p>
                </div>
              </div>

              <span class="shrink-0 rounded-full bg-emerald-400/10 text-emerald-300 border border-emerald-400/20 px-2.5 py-1 text-xs">
                Live
              </span>
            </div>

            <ul class="text-sm text-slate-300 space-y-1 mb-5">
              {app.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-yellow-400">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <div class="flex items-center gap-3">
              <a
                href={app.href}
                class="inline-flex items-center justify-center rounded-xl bg-yellow-400 text-slate-950 font-semibold px-4 py-2 text-sm hover:bg-yellow-300 transition"
              >
                View on App Store
              </a>

              <a
                href="/navapps-site/support"
                class="text-sm text-slate-400 hover:text-slate-200 transition"
              >
                Support
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-6">In development</h2>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {soon.map((app) => (
          <article class="rounded-2xl border border-slate-800 bg-slate-900/20 p-6">
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="h-11 w-11 grid place-items-center rounded-xl bg-slate-800/70 text-xl opacity-90">
                  {app.icon}
                </div>
                <div>
                  <h3 class="text-lg font-semibold">{app.name}</h3>
                  <p class="text-xs text-slate-400">{app.tagline}</p>
                </div>
              </div>

              <span class="shrink-0 rounded-full bg-slate-700/30 text-slate-300 border border-slate-700/50 px-2.5 py-1 text-xs">
                Coming soon
              </span>
            </div>

            <ul class="text-sm text-slate-300 space-y-1">
              {app.bullets.map((b) => (
                <li class="flex gap-2">
                  <span class="text-yellow-400">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <footer class="mt-16 text-center text-sm text-slate-500">
      Support: <a class="underline hover:text-slate-300" href="mailto:support@navapps.org">support@navapps.org</a>
    </footer>
  </main>
</BaseLayout>
